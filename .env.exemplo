# Configuração do Detetor de Fraudes Financeiras.
# O instalar.bat copia este ficheiro para .env e gera uma CHAVE_SECRETA nova.
# Depois de mudar o .env, reinicie o sistema.

# desenvolvimento | teste | producao
AMBIENTE=producao

# Chave usada para assinar sessões, formulários e os modelos treinados. Não partilhe; uma por instalação.
# Se a mudar, treine os modelos de novo (python gerir.py treinar --forcar).
CHAVE_SECRETA=

# Base de dados. Vazio = SQLite em instancia/detetor.db.
# Exemplo PostgreSQL (precisa de instalar psycopg): postgresql+psycopg://utilizador:senha@localhost/detetor
URL_BANCO=

# Pastas (relativas à pasta do projeto ou caminhos completos)
PASTA_MODELOS=modelos
PASTA_LOGS=logs

# DEBUG | INFO | WARNING | ERROR
NIVEL_LOG=INFO

# Endereço do servidor. 127.0.0.1 = só este computador; 0.0.0.0 = toda a rede local.
HOST=127.0.0.1
PORTA=5000
THREADS=4

# Horas até a sessão expirar e ser preciso entrar de novo
SESSAO_HORAS=8

# E-mail (opcional). Com SMTP_SERVIDOR e EMAIL_ALERTAS preenchidos, cada ficheiro analisado que gere
# alertas de alto risco envia um resumo (só contagens e o link, sem dados de clientes).
SMTP_SERVIDOR=
SMTP_PORTA=587
SMTP_UTILIZADOR=
SMTP_SENHA=
SMTP_REMETENTE=
# sim = STARTTLS (porta 587); nao = sem cifra (só numa rede interna de confiança)
SMTP_TLS=sim
# Destinatários, separados por vírgulas
EMAIL_ALERTAS=
# Endereço do sistema usado nos links do e-mail. Vazio = http://HOST:PORTA
URL_PUBLICA=
